{
  "name": "omsi-enhancer",
  "version": "0.4.12",
  "description": "OMSI Enhancer: carriere en diensten voor OMSI 2, het spel startklaar zetten, en de instellingen en toetsen van het spel beheren.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "icon": "python scripts/make-icon.py"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "iconv-lite": "^0.6.3",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "author": {
    "name": "Luc Ruigrok",
    "email": "lucruigrok@gmail.com"
  }
}
